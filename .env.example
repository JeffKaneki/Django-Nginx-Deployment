# Generate a real key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-new-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SQLite development default. For PostgreSQL, set DB_ENGINE=postgresql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Set these to True when HTTPS is correctly configured at Nginx.
SECURE_SSL_REDIRECT=False
SECURE_COOKIES=False
