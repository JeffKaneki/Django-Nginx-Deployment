[Unit]
Description=Gunicorn for the Django login application
Requires=gunicorn.socket
After=network.target

[Service]
Type=simple
User=angel
Group=www-data
WorkingDirectory=/var/www/myproject
EnvironmentFile=/var/www/myproject/.env
ExecStart=/var/www/myproject/venv/bin/gunicorn --workers 3 myproject.wsgi:application
Restart=on-failure
RestartSec=5
UMask=0007

[Install]
WantedBy=multi-user.target
